    "generated_example_count_j0": 0,
    "owner_review_example_slots": 200,
    "owner_review_contrast_pair_slots": 100,
    "review_slots_contain_examples_j0": false,
    "review_slots_contain_owner_labels_j0": false,
    "mix_hypothesis": [
      {
        "category": "clean_acceptable_answers",
        "percent": 30,
        "pilot_count": 120
      },
      {
        "category": "generic_good_but_efish_mismatch",
        "percent": 25,
        "pilot_count": 100
      },
      {
        "category": "controlled_voice_style_negatives",
        "percent": 20,
        "pilot_count": 80
      },
      {
        "category": "subtle_preference_contrast",
        "percent": 15,
        "pilot_count": 60
      },
      {
        "category": "uncertain_or_out_of_scope",
        "percent": 10,
        "pilot_count": 40
      }
    ],
    "mix_status": "hypothesis_requires_owner_validation",
    "required_reverse_controls": [
      "shorter_answer_is_too_cryptic",
      "colder_answer_is_not_preferred",
      "casual_answer_is_not_preferred",
      "playful_answer_is_not_preferred",
      "generic_answer_is_preferred_when_personalized_variant_is_vague"
    ],
    "owner_review_completed": false,
    "validated_owner_export_present": false
  },
  "future_full_target": {
    "minimum_examples": 6000,
    "maximum_examples": 10000,
    "authorized": false,
    "authorization_requires": [
      "owner_approved_pilot",
      "owner_label_repeat_consistency_at_least_0.90",
      "non_trivial_personal_fit_class_distribution",
      "generic_baseline_uplift_at_least_0.10",
      "oracle_personal_presentation_value",
      "privacy_and_provenance_pass"
    ]
  },
  "allowed_source_kinds": [
    "existing_public_safe_project_dialogue",
    "new_project_authored",
    "controlled_deepseek_output",
    "controlled_stylistic_mutation",
    "explicit_owner_authored",
    "owner_reviewed_contrast_pair",
    "public_safe_portfolio_language"
  ],
  "forbidden_source_kinds": [
    "raw_private_chat_export",
    "private_message",
    "email",
    "personal_diary",
    "hidden_memory",
    "assistant_hidden_prompt",
    "system_hidden_prompt",
    "r29_eval_answer_direct_training_copy",
    "live_product_user_conversation",
    "secret_or_identifier_bearing_record"
