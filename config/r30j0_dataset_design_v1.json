  "split_contract": {
    "units": [
      "conversation_family",
      "semantic_family",
      "source_family",
      "mutation_family",
      "event_family"
    ],
    "individual_row_random_split_forbidden": true,
    "owner_review_duplicates_grouped": true,
    "r29_evaluation_families_excluded_from_training": true
  },
  "contrast_pair_contract": {
    "training_supervision_only": true,
    "product_pairwise_architecture": false,
    "same_user_context_required": true,
    "same_factual_content_required": true,
    "owner_preference_values": [
      "A",
      "B",
      "TIE"
    ],
    "must_include_generic_good_personal_mismatch": true,
    "must_include_reverse_controls": true
  },
  "mutation_contract": {
    "implementation": "src/personal_judge/mutation_contract.ts",
    "fact_preservation_required": true,
    "deterministic_guard_is_semantic_proof": false,
    "human_review_required_after_guard": true,
    "failed_mutations_are_discarded": true
  },
  "privacy": {
    "local_first": true,
    "explicit_owner_approval_required": true,
    "versioned": true,
    "editable": true,
    "deletable": true,
    "sensitive_profile_inference": false,
    "online_learning": false,
    "automatic_live_user_collection": false
  },
  "j0_execution": {
    "training_started": false,
    "classification_updates": 0,
    "examples_seen_by_optimizer": 0,
    "assistant_target_tokens": 0,
    "checkpoint": null,
    "candidate": null,
    "api_requests": 0,
    "full_dataset_generated": false
  }
