      "allowed_transformations": ["compression_or_rewrite", "dialogue_rewrite"],
      "forbidden_content": ["long_raw_quote", "private_raw_data"],
      "split_policy": "zh >= 70 percent within category",
      "eval_contamination_guard": "check near-duplicate prompts and targets"
    },
    {
      "category": "Chinese_explanation",
      "target_rows": 250,
      "source_types": ["poem", "essay", "fragment"],
      "review_requirements": ["explain a thought or line without copying source wholesale"],
      "allowed_transformations": ["Chinese_explanation", "style_card"],
      "forbidden_content": ["wholesale_source_copy", "chain_of_thought"],
