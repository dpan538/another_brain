    {
      "category": "preference_pairs",
      "target_rows": 250,
      "source_types": ["preferred_answer", "rejected_and_repaired_answer"],
      "review_requirements": ["weak and preferred answer both reviewed as safe"],
      "allowed_transformations": ["preference_pair", "repair_pair"],
      "forbidden_content": ["private_raw_memory", "secret_like_string"],
      "split_policy": "paired rows stay in one split",
      "eval_contamination_guard": "reject if weak or preferred text matches eval fixtures"
