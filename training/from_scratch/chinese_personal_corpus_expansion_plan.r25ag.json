  "chain_of_thought_allowed": false,
  "target_total_rows": {
    "minimum": 1000,
    "preferred_floor": 3000,
    "meaning": "Convert reviewed writing and project-style material into derived rows before any later micro-cycle."
  },
  "target_language_mix": {
    "zh_min": 0.7,
    "mixed_target": 0.2,
    "en_max": 0.1
