      "target_rows": 250,
      "source_types": ["project_note", "preferred_answer", "fragment"],
      "review_requirements": ["reviewed_source_manifest", "derived_row_review", "split_assignment_before_use"],
      "allowed_transformations": ["project_continuation", "dialogue_rewrite"],
      "forbidden_content": ["raw_private_memory", "local_private_paths", "eval_prompt_copy"],
      "split_policy": "assign train/dev/heldout before any future training; heldout never reused for training",
      "eval_contamination_guard": "compare prompts and target text against evals before admission"
    },
    {
      "category": "repair_after_weak_answer",
      "target_rows": 250,
      "source_types": ["rejected_and_repaired_answer", "preferred_answer"],
      "review_requirements": ["weak_answer_generic_or_project_authored", "preferred_answer_reviewed"],
      "allowed_transformations": ["repair_pair", "preference_pair"],
      "forbidden_content": ["chain_of_thought", "hidden_prompt", "private_claim_without_review"],
      "split_policy": "keep source families split-safe",
      "eval_contamination_guard": "do not train on eval prompts or heldout answers"
    },
    {
      "category": "local_first_static_browser_reasoning",
      "target_rows": 250,
      "source_types": ["project_note", "preferred_answer"],
      "review_requirements": ["must preserve no backend, no external API, same-origin static artifact boundaries"],
      "allowed_transformations": ["dialogue_rewrite", "bounded_judgment", "project_continuation"],
      "forbidden_content": ["backend_or_storage_product_path", "external_model_api", "phase4_approval_claim"],
      "split_policy": "balance across zh and mixed buckets",
      "eval_contamination_guard": "derive from project decisions, not heldout eval text"
    },
    {
      "category": "style_preference",
      "target_rows": 300,
      "source_types": ["poem", "essay", "fragment", "preferred_answer"],
      "review_requirements": ["style trait reviewed without copying long source text"],
      "allowed_transformations": ["style_card", "dialogue_rewrite", "compression_or_rewrite"],
      "forbidden_content": ["wholesale_poem_copy", "third_party_copyrighted_text"],
      "split_policy": "prefer zh rows; keep en technical-only",
      "eval_contamination_guard": "style cards cannot include eval prompt text"
    },
    {
      "category": "tool_status_honesty",
      "target_rows": 200,
      "source_types": ["project_note", "preferred_answer", "rejected_and_repaired_answer"],
      "review_requirements": ["must distinguish done, not done, blocked, and unavailable runtime states"],
      "allowed_transformations": ["preference_pair", "repair_pair", "project_continuation"],
      "forbidden_content": ["claimed_command_execution_without_evidence", "external_api_claim"],
      "split_policy": "hold out representative repair cases",
      "eval_contamination_guard": "do not copy tool-status eval prompts"
    },
    {
      "category": "bounded_judgment",
      "target_rows": 250,
      "source_types": ["essay", "fragment", "preferred_answer"],
