{
  "run_id": "r25ar_repaired_sampler_microcycle",
  "variant_id": "r25ar_mixed_repair_lower_intensity",
  "training_allowed_by_default": false,
  "approval_required": true,
  "requires_fresh_approval": true,
  "product_model": false,
  "release_checkpoint": false,
  "formal_decoder_training": false,
  "formal_product_training": false,
  "long_term_training": false,
  "phase_4_scaled_training": false,
  "commit_weights_allowed": false,
  "tokenizer_dry_run_allowed": false,
  "corpus_expansion_allowed": false,
