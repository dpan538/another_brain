{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Question pack manifest",
  "oneOf": [
    {
      "title": "Question pack row manifest",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pack_id",
        "source_file",
        "source_file_committed",
        "raw_source_private",
        "row_id",
        "module",
        "scene",
        "speaker_context",
        "question_intent",
        "suggested_answer_mode",
        "question",
        "answer_target",
        "user_answer",
        "should_answer",
        "rough_rating",
        "public_training_initial_judgment",
        "tags",
        "eligibility",
        "exclusion_reason",
        "allowed_uses",
        "forbidden_uses",
        "contains_private_data",
        "review_status",
        "reviewer",
        "notes"
      ],
      "properties": {
        "pack_id": { "type": "string" },
        "source_file": { "type": "string" },
        "source_file_committed": { "type": "boolean" },
        "raw_source_private": { "type": "boolean" },
        "row_id": { "type": "integer", "minimum": 1 },
        "module": { "type": "string" },
        "scene": { "type": "string" },
        "speaker_context": { "type": "string" },
        "question_intent": { "type": "string" },
        "suggested_answer_mode": { "type": "string" },
        "question": { "type": "string" },
        "answer_target": { "type": "string" },
        "user_answer": { "type": "string" },
        "should_answer": { "type": "boolean" },
        "rough_rating": { "type": ["number", "string", "null"] },
        "public_training_initial_judgment": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "eligibility": {
          "enum": [
            "candidate_review_only",
            "eligible_after_review",
            "excluded_from_training",
            "policy_instruction_only",
            "unknown"
          ]
        },
        "exclusion_reason": { "type": "string" },
        "allowed_uses": { "type": "array", "items": { "type": "string" } },
        "forbidden_uses": { "type": "array", "items": { "type": "string" } },
        "contains_private_data": { "type": "boolean" },
        "review_status": { "type": "string" },
        "reviewer": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    {
      "title": "Question pack top-level manifest",
      "type": "object",
      "additionalProperties": true,
      "required": [
        "pack_id",
        "raw_source_path",
        "raw_source_committed",
        "total_rows_expected",
        "candidate_review_only_range",
        "excluded_from_training_range",
        "candidate_rows_count",
        "excluded_rows_count",
        "exclusion_reason"
      ],
      "properties": {
        "pack_id": { "type": "string" },
        "raw_source_path": { "type": "string" },
        "raw_source_committed": { "const": false },
        "raw_source_should_not_be_committed": { "type": "boolean" },
        "total_rows_expected": { "type": "integer", "minimum": 1 },
        "candidate_review_only_range": { "type": "string" },
        "excluded_from_training_range": { "type": "string" },
        "candidate_rows_count": { "type": "integer", "minimum": 0 },
        "excluded_rows_count": { "type": "integer", "minimum": 0 },
        "answered_first50_count": { "type": "integer", "minimum": 0 },
        "blank_first50_count": { "type": "integer", "minimum": 0 },
        "exclusion_reason": { "type": "string" },
        "allowed_uses_for_1_to_50": { "type": "array", "items": { "type": "string" } },
        "forbidden_uses_for_1_to_50_in_r26d": { "type": "array", "items": { "type": "string" } },
        "forbidden_uses_for_51_to_100": { "type": "array", "items": { "type": "string" } }
      }
    }
  ]
}
