{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "R26D answer-as-user candidate row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sample_id",
    "pack_id",
    "source_row_id",
    "source_row_range_policy",
    "language",
    "module",
    "scene",
    "speaker_context",
    "question_intent",
    "suggested_answer_mode",
    "question",
    "answer_target_note",
    "user_answer_raw",
    "user_answer_clean",
    "should_answer",
    "answer_mode",
    "answer_as",
    "stance",
    "evidence_policy",
    "candidate_type",
    "target_answer",
    "rejected_answers",
    "tags",
    "risk_flags",
    "split_suggestion",
    "eligibility",
    "exclusion_reason",
    "provenance",
    "review_status",
    "contains_private_data",
    "training_allowed",
    "public_commit_allowed"
  ],
  "properties": {
    "sample_id": { "type": "string" },
    "pack_id": { "const": "another_brain_question_pack_001" },
    "source_row_id": { "type": "integer", "minimum": 1, "maximum": 50 },
    "source_row_range_policy": { "type": "string" },
    "language": { "enum": ["zh", "mixed", "en"] },
    "module": { "type": "string" },
    "scene": { "type": "string" },
    "speaker_context": { "enum": ["friend", "stranger", "collaborator", "project_agent", "public_comment", "unknown"] },
    "question_intent": { "enum": ["ask_opinion", "challenge", "correction", "weird_question", "project_question", "emotional_pressure", "factual_memory_check", "style_request", "boundary_test"] },
    "suggested_answer_mode": { "type": "string" },
    "question": { "type": "string", "minLength": 1 },
    "answer_target_note": { "type": "string" },
    "user_answer_raw": { "type": "string" },
    "user_answer_clean": { "type": "string" },
    "should_answer": { "type": "boolean" },
    "answer_mode": { "enum": ["direct_answer", "partial_answer", "refuse", "redirect", "counterquestion", "abstract_reframe", "pressure_resistance", "evidence_based_correction", "memory_uncertain_but_not_wrong", "compressed_judgment"] },
    "answer_as": { "const": "user_self" },
    "stance": { "enum": ["assert", "soften", "refuse", "reconsider", "uncertain", "correct_self", "reject_premise"] },
    "evidence_policy": { "enum": ["unsupported_challenge", "evidence_present", "memory_uncertain", "value_disagreement", "no_evidence_needed", "private_boundary"] },
    "candidate_type": {
      "enum": [
        "direct_user_answer",
        "partial_answer",
        "refusal_boundary",
        "relationship_context_answer",
        "unsupported_challenge_resistance",
        "weird_question_abstraction",
        "memory_uncertain_boundary",
        "compressed_judgment",
        "answer_mode_annotation",
        "source_slice"
      ]
    },
    "target_answer": { "type": "string", "minLength": 1 },
    "rejected_answers": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "risk_flags": { "type": "array", "items": { "type": "string" } },
    "split_suggestion": { "enum": ["train", "dev", "heldout_candidate"] },
    "eligibility": { "const": "candidate_review_only" },
    "exclusion_reason": { "type": "string" },
    "provenance": {
      "type": "object",
      "required": ["source_type", "external_llm_used", "pack_id", "generator", "raw_source_committed"],
      "properties": {
        "source_type": { "const": "user_answered" },
        "external_llm_used": { "const": false },
        "pack_id": { "const": "another_brain_question_pack_001" },
        "generator": { "type": "string" },
        "raw_source_committed": { "const": false },
        "slice_from_sample_id": { "type": "string" }
      }
    },
    "review_status": { "const": "candidate_unreviewed" },
    "contains_private_data": { "enum": [false, "needs_review"] },
    "training_allowed": { "const": false },
    "public_commit_allowed": { "const": false }
  },
  "not": {
    "anyOf": [
      { "required": ["chain_of_thought"] },
      { "required": ["hidden_prompt"] },
      { "required": ["raw_private_data"] },
      { "required": ["local_private_path"] }
    ]
  }
}
