    },
    {
      "id": "r28postmerge13-commonsense-money-coordination",
      "kind": "commonsense",
      "text": "货币的作用不只是买东西。它把价值比较、延期支付和陌生人协作压缩成一个共同符号。",
      "provenance": "approved_anchor_summary",
      "allowed_for_training": false,
      "private_raw_data": false,
      "review_status": "approved_for_runtime",
      "keywords": ["货币", "钱", "价值", "支付", "陌生人", "协作", "符号"],
      "tone_hints": ["commonsense", "economy", "coordination"]
    },
    {
      "id": "r28postmerge13-society-map-territory",
      "kind": "logic",
      "text": "地图不是领土。模型、概念和指标都能帮助理解现实，但不能替代现实本身；要随反馈修正。",
      "provenance": "approved_anchor_summary",
      "allowed_for_training": false,
      "private_raw_data": false,
      "review_status": "approved_for_runtime",
