    },
    {
      "id": "r28postmerge12-aesthetic-accessible-minimalism",
      "kind": "aesthetic",
      "text": "有质感的极简必须可读。象牙白、深绿和黑色可以高级，但文字对比、行距和触控面积必须先成立。",
      "provenance": "approved_anchor_summary",
      "allowed_for_training": false,
      "private_raw_data": false,
      "review_status": "approved_for_runtime",
      "keywords": ["可读性", "WCAG", "象牙白", "深绿", "黑色", "行距", "触控"],
      "tone_hints": ["accessibility", "minimalism", "contrast"]
    },
    {
      "id": "r28postmerge12-history-renaissance-printing",
      "kind": "history",
      "text": "文艺复兴和印刷术的意义不只是艺术复兴，也在于知识复制成本下降，让思想传播速度和公共讨论结构发生改变。",
      "provenance": "approved_anchor_summary",
      "allowed_for_training": false,
      "private_raw_data": false,
      "review_status": "approved_for_runtime",
      "keywords": ["文艺复兴", "印刷术", "古登堡", "知识传播", "公共讨论", "艺术"],
      "tone_hints": ["history", "media", "knowledge"]
    },
    {
      "id": "r28postmerge12-history-enlightenment-reason",
      "kind": "history",
      "text": "启蒙运动把理性、公共讨论、科学方法和个人权利推到前台，但也留下技术理性与现实权力之间的张力。",
      "provenance": "approved_anchor_summary",
      "allowed_for_training": false,
      "private_raw_data": false,
      "review_status": "approved_for_runtime",
      "keywords": ["启蒙", "理性", "科学方法", "公共讨论", "个人权利", "权力"],
      "tone_hints": ["history", "reason", "tension"]
    },
    {
      "id": "r28postmerge12-society-ai-automation-work",
      "kind": "society",
      "text": "AI 和自动化的问题不能只问会不会替代人，还要问谁获得杠杆、谁被重新定价、哪些判断仍需要责任。",
      "provenance": "approved_anchor_summary",
      "allowed_for_training": false,
      "private_raw_data": false,
      "review_status": "approved_for_runtime",
      "keywords": ["AI", "自动化", "工作", "替代", "杠杆", "责任", "劳动"],
      "tone_hints": ["technology", "labor", "responsibility"]
    },
    {
      "id": "r28postmerge12-society-public-trust",
      "kind": "society",
      "text": "公共信任不是靠口号建立的，它来自透明规则、可追责机制、稳定兑现和人们重复经历后的判断。",
      "provenance": "approved_anchor_summary",
      "allowed_for_training": false,
      "private_raw_data": false,
      "review_status": "approved_for_runtime",
      "keywords": ["公共信任", "规则", "追责", "兑现", "制度", "社会", "判断"],
      "tone_hints": ["trust", "institution", "practical"]
    },
    {
      "id": "r28postmerge12-commonsense-water-boiling",
      "kind": "commonsense",
      "text": "水沸腾不是固定神秘温度，而是蒸气压和外界气压达到平衡；海拔变化会改变沸点。",
      "provenance": "hand_authored_boundary",
      "allowed_for_training": false,
      "private_raw_data": false,
      "review_status": "approved_for_runtime",
      "keywords": ["水", "沸腾", "沸点", "蒸气压", "气压", "海拔", "温度"],
      "tone_hints": ["science", "mechanism", "condition"]
    },
    {
      "id": "r28postmerge12-commonsense-sound-vibration",
      "kind": "commonsense",
      "text": "声音来自振动，需要介质传播；在真空中没有空气分子传递振动，所以声音无法像在空气中那样传播。",
      "provenance": "hand_authored_boundary",
      "allowed_for_training": false,
      "private_raw_data": false,
      "review_status": "approved_for_runtime",
      "keywords": ["声音", "振动", "介质", "空气", "真空", "传播", "物理"],
      "tone_hints": ["physics", "plain", "mechanism"]
    },
    {
      "id": "r28postmerge12-brand-product-memory",
      "kind": "brand_literacy",
      "text": "一个产品被记住，通常不是因为解释很多，而是因为名字、动作、视觉和第一次成功体验能连成一个稳定记忆。",
      "provenance": "approved_anchor_summary",
      "allowed_for_training": false,
      "private_raw_data": false,
      "review_status": "approved_for_runtime",
      "keywords": ["产品", "品牌", "名字", "视觉", "体验", "记忆", "第一次成功"],
      "tone_hints": ["brand", "product", "memory"]
    },
    {
      "id": "r28postmerge12-logic-base-rate",
      "kind": "logic",
      "text": "判断概率时，基准率很重要。一个故事再生动，也不能替代总体比例、样本来源和失败案例。",
      "provenance": "approved_anchor_summary",
      "allowed_for_training": false,
      "private_raw_data": false,
      "review_status": "approved_for_runtime",
      "keywords": ["基准率", "概率", "样本", "失败案例", "故事", "判断", "风险"],
      "tone_hints": ["base_rate", "logic", "risk"]
    },
    {
      "id": "r28postmerge13-association-railway-network",
      "kind": "association",
      "text": "铁路的方便来自网络效应：速度、标准时间、站点、物流和城市扩张被接成稳定系统，使远距离协作变得可预期。",
      "provenance": "approved_anchor_summary",
      "allowed_for_training": false,
      "private_raw_data": false,
      "review_status": "approved_for_runtime",
      "keywords": ["铁路", "火车", "高铁", "交通", "物流", "标准时间", "城市", "网络效应", "方便"],
      "tone_hints": ["association", "infrastructure", "network"]
    },
    {
      "id": "r28postmerge13-association-time-frames",
      "kind": "association",
      "text": "时间是否线性要先分框架：钟表时间强调先后顺序，心理时间会被记忆拉伸，叙事时间常按意义重新排列。",
      "provenance": "approved_anchor_summary",
      "allowed_for_training": false,
      "private_raw_data": false,
      "review_status": "approved_for_runtime",
      "keywords": ["时间", "线性", "钟表时间", "心理时间", "叙事时间", "记忆", "因果顺序"],
      "tone_hints": ["time", "classification", "philosophy"]
    },
    {
      "id": "r28postmerge13-context-followup-carry",
      "kind": "context",
      "text": "追问常常省略对象。遇到“它”“这个”“为什么方便”时，应优先承接最近一轮主题，再判断功能、机制和影响。",
      "provenance": "hand_authored_boundary",
      "allowed_for_training": false,
      "private_raw_data": false,
      "review_status": "approved_for_runtime",
      "keywords": ["上下文", "追问", "它", "这个", "为什么方便", "关联", "承接", "会话"],
      "tone_hints": ["context", "followup", "local_session"]
    },
    {
      "id": "r28postmerge13-logic-causal-answer",
      "kind": "logic",
      "text": "好的因果回答要分清现象、机制、证据和反例。先说明什么发生了，再说明为什么可能发生，最后留下边界。",
      "provenance": "approved_anchor_summary",
      "allowed_for_training": false,
      "private_raw_data": false,
      "review_status": "approved_for_runtime",
      "keywords": ["因果", "现象", "机制", "证据", "反例", "为什么", "推理"],
      "tone_hints": ["causal", "reasoning", "boundary"]
    },
    {
      "id": "r28postmerge13-judgment-fact-value-aesthetic",
      "kind": "judgment",
      "text": "判断一个问题是否有对错，先看它属于事实、价值还是审美。事实题看证据，价值题看理由，审美题看结构和语境。",
      "provenance": "approved_anchor_summary",
      "allowed_for_training": false,
      "private_raw_data": false,
      "review_status": "approved_for_runtime",
      "keywords": ["对错", "事实判断", "价值判断", "审美判断", "证据", "理由", "结构", "语境"],
      "tone_hints": ["judgment", "classification", "truth"]
    },
    {
      "id": "r28postmerge13-commonsense-infrastructure",
      "kind": "commonsense",
      "text": "基础设施的价值通常不在单个物件，而在连接：道路、铁路、电网和网络把分散行动变成可协调的生活。",
      "provenance": "approved_anchor_summary",
      "allowed_for_training": false,
      "private_raw_data": false,
      "review_status": "approved_for_runtime",
      "keywords": ["基础设施", "道路", "铁路", "电网", "网络", "连接", "协调", "生活"],
      "tone_hints": ["commonsense", "society", "network"]
    },
    {
      "id": "r28postmerge13-society-standard-time",
      "kind": "society",
      "text": "标准时间的普及和铁路、电报、工业调度有关；它让陌生城市之间可以按同一张时间表协作。",
      "provenance": "approved_anchor_summary",
      "allowed_for_training": false,
      "private_raw_data": false,
      "review_status": "approved_for_runtime",
      "keywords": ["标准时间", "铁路", "电报", "工业", "调度", "城市", "协作"],
      "tone_hints": ["history", "time", "coordination"]
    },
    {
      "id": "r28postmerge13-philosophy-meaning-action",
      "kind": "philosophy",
      "text": "意义不总是先被发现，也常在行动后形成。人会通过选择、关系、作品和承担，把抽象问题变成可生活的方向。",
      "provenance": "approved_anchor_summary",
      "allowed_for_training": false,
      "private_raw_data": false,
      "review_status": "approved_for_runtime",
      "keywords": ["意义", "行动", "选择", "关系", "作品", "承担", "生活", "哲学"],
      "tone_hints": ["meaning", "action", "plain"]
    },
    {
      "id": "r28postmerge13-aesthetic-judgment-not-preference",
      "kind": "aesthetic",
      "text": "审美不是单纯喜欢。更强的审美判断会解释比例、材料、节奏、语境和风险为什么让一个形式站住。",
      "provenance": "approved_anchor_summary",
      "allowed_for_training": false,
      "private_raw_data": false,
      "review_status": "approved_for_runtime",
      "keywords": ["审美", "美学", "比例", "材料", "节奏", "语境", "风险", "判断"],
      "tone_hints": ["aesthetic", "criteria", "form"]
    },
    {
      "id": "r28postmerge13-context-topic-bridge",
      "kind": "context",
      "text": "连续对话需要主题桥。新问题如果短、含代词或只问“为什么”，应把最近的用户问题和上一条回答作为局部语境。",
      "provenance": "hand_authored_boundary",
      "allowed_for_training": false,
