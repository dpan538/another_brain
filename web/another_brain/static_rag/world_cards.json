    },
    {
      "id": "r28postmerge13-history-printing-internet-analogy",
      "kind": "association",
      "text": "印刷术和互联网都改变了复制、分发和讨论成本。类比时要看共同机制，也要保留技术时代差异。",
      "provenance": "approved_anchor_summary",
      "allowed_for_training": false,
      "private_raw_data": false,
      "review_status": "approved_for_runtime",
      "keywords": ["印刷术", "互联网", "类比", "复制", "分发", "讨论成本", "技术差异"],
