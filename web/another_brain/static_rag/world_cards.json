    },
    {
      "id": "r28postmerge13-philosophy-freedom-constraint",
      "kind": "philosophy",
      "text": "自由不是没有限制，而是在限制中仍能做出选择并承担后果。没有边界的自由很容易变成任性。",
      "provenance": "approved_anchor_summary",
      "allowed_for_training": false,
      "private_raw_data": false,
      "review_status": "approved_for_runtime",
      "keywords": ["自由", "限制", "选择", "承担", "后果", "边界", "价值"],
