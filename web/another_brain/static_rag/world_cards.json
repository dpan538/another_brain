    },
    {
      "id": "r28postmerge13-association-cost-benefit",
      "kind": "association",
      "text": "解释“为什么有用”时，可以先看它降低了什么成本、放大了什么能力、让哪些关系变得更稳定。",
      "provenance": "approved_anchor_summary",
      "allowed_for_training": false,
