  "cards": [
    {
      "id": "r28livefix0-commonsense-sky-blue",
      "kind": "commonsense",
      "text": "For why-the-sky-is-blue questions, the stable explanation axis is light scattering: shorter blue wavelengths scatter more strongly through the atmosphere. Keep it short and concrete.",
      "provenance": "hand_authored_boundary",
      "allowed_for_training": false,
      "private_raw_data": false,
      "review_status": "approved_for_runtime",
      "keywords": ["天空", "蓝天", "为什么天是蓝色", "散射", "光", "atmosphere", "sky blue"],
      "tone_hints": ["mechanism", "short", "concrete"]
    },
    {
      "id": "r28livefix0-commonsense-seasons",
      "kind": "commonsense",
      "text": "For seasons, separate Earth tilt from distance to the Sun. Seasonal change is mainly about sunlight angle and day length, not simply being closer or farther.",
      "provenance": "hand_authored_boundary",
      "allowed_for_training": false,
      "private_raw_data": false,
      "review_status": "approved_for_runtime",
      "keywords": ["四季", "季节", "地轴", "太阳角度", "昼夜", "seasons", "earth tilt"],
      "tone_hints": ["distinction", "commonsense", "no_overclaim"]
    },
    {
      "id": "r28livefix0-commonsense-moon-phases",
      "kind": "commonsense",
      "text": "For Moon phase questions, distinguish the Moon's shape from illumination. The visible phase changes because we see different sunlit portions as the Moon orbits Earth.",
      "provenance": "hand_authored_boundary",
      "allowed_for_training": false,
      "private_raw_data": false,
      "review_status": "approved_for_runtime",
      "keywords": ["月亮", "月相", "月缺", "月圆", "绕地球", "moon phase", "illumination"],
      "tone_hints": ["visual", "mechanism", "plain"]
    },
    {
      "id": "r28livefix0-logic-correlation-causation",
      "kind": "logic",
      "text": "When two things move together, do not immediately claim causation. Check timing, mechanism, alternative causes, and whether the relation survives counterexamples.",
      "provenance": "approved_anchor_summary",
      "allowed_for_training": false,
      "private_raw_data": false,
      "review_status": "approved_for_runtime",
      "keywords": ["相关", "因果", "机制", "反例", "时间顺序", "correlation", "causation"],
      "tone_hints": ["causal_discipline", "counterexample", "compact"]
    },
    {
      "id": "r28livefix0-philosophy-justice-fairness",
      "kind": "philosophy",
      "text": "For justice and fairness questions, separate equal treatment, deserved treatment, repair of harm, and power imbalance. A useful answer names the tension instead of flattening it.",
      "provenance": "approved_anchor_summary",
      "allowed_for_training": false,
      "private_raw_data": false,
      "review_status": "approved_for_runtime",
      "keywords": ["正义", "公平", "平等", "伤害", "权力", "justice", "fairness"],
      "tone_hints": ["tension", "not_slogan", "ethical"]
    },
    {
      "id": "r28livefix0-philosophy-loneliness",
      "kind": "philosophy",
      "text": "For loneliness questions, avoid treating loneliness only as lack of people. It can also be a mismatch between being seen, being understood, and having a place to act.",
      "provenance": "approved_anchor_summary",
      "allowed_for_training": false,
      "private_raw_data": false,
      "review_status": "approved_for_runtime",
      "keywords": ["孤独", "孤单", "理解", "被看见", "关系", "loneliness"],
      "tone_hints": ["human", "precise", "not_preachy"]
    },
    {
      "id": "r28livefix0-philosophy-memory-identity",
      "kind": "philosophy",
      "text": "For memory and identity questions, memory is not a full archive. It selects, distorts, preserves, and gives continuity, so identity should be treated as a living pattern.",
      "provenance": "approved_anchor_summary",
      "allowed_for_training": false,
      "private_raw_data": false,
      "review_status": "approved_for_runtime",
      "keywords": ["记忆", "身份", "自我", "连续性", "遗忘", "memory", "identity"],
      "tone_hints": ["nuanced", "pattern", "compressed"]
    },
    {
      "id": "r28livefix0-aesthetic-color-material",
      "kind": "aesthetic",
      "text": "For color and material questions, useful judgment looks at contrast, rhythm, legibility, tactility, and whether the palette supports the intended emotional temperature.",
      "provenance": "approved_anchor_summary",
      "allowed_for_training": false,
      "private_raw_data": false,
      "review_status": "approved_for_runtime",
      "keywords": ["颜色", "配色", "材质", "质感", "对比", "节奏", "可读性", "palette", "material"],
      "tone_hints": ["visual", "material", "legibility"]
    },
    {
      "id": "r28postmerge3-commonsense-water-boiling",
      "kind": "commonsense",
      "text": "For water boiling questions, keep the mechanism concrete: heating raises molecular motion until vapor pressure can overcome surrounding pressure; altitude changes the boiling point.",
      "provenance": "approved_anchor_summary",
      "allowed_for_training": false,
      "private_raw_data": false,
      "review_status": "approved_for_runtime",
      "keywords": ["水", "沸腾", "烧开", "蒸汽", "压力", "海拔", "boiling", "temperature"],
      "tone_hints": ["mechanism", "plain_science", "compact"]
    },
    {
      "id": "r28postmerge3-commonsense-why-rain",
      "kind": "commonsense",
      "text": "For rain questions, separate evaporation, cooling, condensation, cloud droplets, and gravity. Rain is a phase-change and atmosphere-circulation event, not a mysterious sign.",
      "provenance": "approved_anchor_summary",
      "allowed_for_training": false,
      "private_raw_data": false,
      "review_status": "approved_for_runtime",
      "keywords": ["下雨", "雨", "蒸发", "冷却", "凝结", "云", "水循环", "rain"],
      "tone_hints": ["natural_mechanism", "stepwise", "short"]
    },
    {
      "id": "r28postmerge3-commonsense-sound",
      "kind": "commonsense",
      "text": "For sound questions, the useful axis is vibration moving through a medium. Frequency relates to pitch, amplitude to loudness, and no medium means ordinary sound cannot travel.",
      "provenance": "approved_anchor_summary",
      "allowed_for_training": false,
      "private_raw_data": false,
      "review_status": "approved_for_runtime",
      "keywords": ["声音", "振动", "频率", "响度", "介质", "真空", "sound", "pitch"],
      "tone_hints": ["physics", "distinction", "concrete"]
    },
    {
      "id": "r28postmerge3-philosophy-truth",
      "kind": "philosophy",
      "text": "For truth questions, distinguish factual accuracy, coherence, usefulness, and honesty about uncertainty. Truth is not the same as a sentence sounding confident.",
      "provenance": "approved_anchor_summary",
      "allowed_for_training": false,
      "private_raw_data": false,
      "review_status": "approved_for_runtime",
      "keywords": ["真理", "真实", "事实", "一致性", "不确定", "truth", "honesty"],
      "tone_hints": ["epistemic", "confidence_boundary", "not_slogan"]
    },
    {
      "id": "r28postmerge3-philosophy-freedom",
      "kind": "philosophy",
      "text": "For freedom questions, avoid treating freedom as doing anything. Useful judgment separates choice, constraint, responsibility, capacity, and the effect one choice has on others.",
      "provenance": "approved_anchor_summary",
      "allowed_for_training": false,
      "private_raw_data": false,
      "review_status": "approved_for_runtime",
      "keywords": ["自由", "选择", "限制", "责任", "能力", "他人", "freedom"],
      "tone_hints": ["ethical", "constraint", "responsibility"]
    },
    {
      "id": "r28postmerge3-aesthetic-technology-product",
      "kind": "aesthetic",
      "text": "For technology product design, judgment should weigh clarity, restraint, contrast, information hierarchy, latency feel, trust cues, and whether the interface hides complexity at the right layer.",
      "provenance": "approved_anchor_summary",
      "allowed_for_training": false,
      "private_raw_data": false,
      "review_status": "approved_for_runtime",
      "keywords": ["科技产品", "界面", "层级", "延迟", "信任", "克制", "深色", "UI"],
      "tone_hints": ["product_design", "hierarchy", "trust"]
    }
  ]
