{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://efishother.local/schemas/local_critic_packet_v1.schema.json",
  "title": "Local Critic Packet V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "style_target", "issues", "preferred_spans"],
  "properties": {
    "version": { "const": "local-critic.v1" },
    "style_target": {
      "enum": ["quiet_warm", "concise_direct", "reflective", "playful_light", "balanced", "matter_of_fact"]
    },
    "issues": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": ["too_formal", "too_verbose", "too_cold", "too_warm", "customer_service_tone", "textbook_tone", "repetitive", "unnaturally_structured", "none"]
      }
    },
    "preferred_spans": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text"],
        "properties": {
          "text": { "type": "string", "minLength": 1, "maxLength": 160 }
        }
      }
    }
  }
}
