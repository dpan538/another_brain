{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://efishother.local/schemas/r30j0_p2_persona_microtrait_catalog_v1.schema.json",
  "title": "PersonaMicrotraitCatalogV1",
  "description": "Behavioural, conditional microtrait hypotheses; never a personality diagnosis or an adjective-only profile.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "status",
    "owner_review_completed",
    "allowed_for_training",
    "entries"
  ],
  "properties": {
    "version": {"const": "persona-microtrait-catalog.v1"},
    "status": {"enum": ["EMPTY_TEMPLATE", "HYPOTHESES_OWNER_REVIEW_REQUIRED", "OWNER_REVIEW_IN_PROGRESS"]},
    "owner_review_completed": {"const": false},
    "allowed_for_training": {"const": false},
    "entries": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/microtrait"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"enum": ["HYPOTHESES_OWNER_REVIEW_REQUIRED", "OWNER_REVIEW_IN_PROGRESS"]}},
        "required": ["status"]
      },
      "then": {"properties": {"entries": {"minItems": 40}}}
    }
  ],
  "$defs": {
    "safeId": {"type": "string", "pattern": "^(?!wired$)[a-z][a-z0-9._-]{2,127}$"},
    "publicSafeText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "not": {"pattern": "[Ww][Ii][Rr][Ee][Dd]"}
    },
    "family": {
      "enum": [
        "RESPONSE_SHAPE",
        "SOCIAL_STANCE",
        "EPISTEMIC_STANCE",
        "HUMOUR_STRATEGY",
        "ROLEPLAY_PERSONA",
        "SERIOUSNESS_SWITCHING",
        "EXPLANATION_STRATEGY",
        "AGREEMENT_DISAGREEMENT",
        "EMOTIONAL_RESPONSE_STYLE",
        "PHILOSOPHICAL_RESPONSE_STYLE",
        "TECHNICAL_RESPONSE_STYLE",
        "ABSURD_WEIRD_QUESTION_HANDLING",
        "LANGUAGE_CODE_SWITCHING",
        "OPENING_CLOSING_BEHAVIOUR",
        "INTERACTION_RHYTHM",
        "AI_SELF_PRESENTATION",
        "ANTI_PATTERNS"
      ]
    },
    "behaviourClass": {
      "enum": [
        "TEXT_SEMANTIC",
        "TEXT_STYLE",
        "PRESENTATION",
        "INTERACTION_POLICY",
        "ROLEPLAY",
        "META_AI",
        "UNKNOWN"
      ]
    },
    "epistemicCategory": {
      "enum": [
        "REAL_UNCERTAINTY",
        "PLAYFUL_FAUX_IGNORANCE",
        "ROLEPLAYED_IGNORANCE",
        "REFUSAL_TO_OVEREXPLAIN",
        "DEADPAN_MISDIRECTION",
        null
      ]
    },
    "register": {
      "enum": [
        "ordinary_chat",
        "casual_banter",
        "weird_question",
        "absurd_meta_ai",
        "practical_advice",
        "technical_explanation",
        "debugging",
        "project_discussion",
        "academic_discussion",
        "philosophy",
        "personal_reflection",
        "light_emotional",
        "formal_message",
        "creative_play",
        "roleplay"
      ]
    },
    "evidenceTimeBucket": {
      "enum": ["early_project", "middle_project", "recent_project", "current", "unknown"]
    },
    "microtrait": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "microtrait_id",
        "behaviour_code",
        "observable_behaviour",
        "dimension_family",
        "behaviour_class",
        "epistemic_category",
        "trigger_positive",
        "trigger_negative",
        "compatible_registers",
        "forbidden_registers",
        "boundary_pair_refs",
        "evidence_route",
        "evidence_refs",
        "independent_normative_evidence_count",
        "elicitation_confirmed",
        "evidence_time_buckets",
        "confidence",
        "owner_review_status",
        "owner_review_required",
        "allowed_for_training",
        "contains_raw_excerpt"
      ],
      "properties": {
        "microtrait_id": {"$ref": "#/$defs/safeId"},
        "behaviour_code": {"$ref": "#/$defs/safeId"},
        "observable_behaviour": {"$ref": "#/$defs/publicSafeText"},
        "dimension_family": {"$ref": "#/$defs/family"},
        "behaviour_class": {"$ref": "#/$defs/behaviourClass"},
        "epistemic_category": {"$ref": "#/$defs/epistemicCategory"},
        "trigger_positive": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/publicSafeText"}
        },
        "trigger_negative": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/publicSafeText"}
        },
        "compatible_registers": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "items": {"$ref": "#/$defs/register"}
        },
        "forbidden_registers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/register"}
        },
        "boundary_pair_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/safeId"}
        },
        "evidence_route": {
          "enum": [
            "EXPLICIT_OWNER_ASSERTION",
            "THREE_INDEPENDENT_HISTORICAL_NORMATIVE_ITEMS",
            "TWO_ITEMS_PLUS_OWNER_ELICITATION",
            "INSUFFICIENT_HYPOTHESIS_ONLY"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/safeId"}
        },
        "independent_normative_evidence_count": {"type": "integer", "minimum": 0},
        "elicitation_confirmed": {"type": "boolean"},
        "evidence_time_buckets": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/evidenceTimeBucket"}
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "owner_review_status": {"enum": ["UNREVIEWED", "ACCEPT", "REJECT", "EDIT", "DEPENDS", "UNSURE"]},
        "owner_review_required": {"const": true},
        "allowed_for_training": {"const": false},
        "contains_raw_excerpt": {"const": false}
      },
      "allOf": [
        {
          "if": {"properties": {"evidence_route": {"const": "THREE_INDEPENDENT_HISTORICAL_NORMATIVE_ITEMS"}}, "required": ["evidence_route"]},
          "then": {"properties": {"independent_normative_evidence_count": {"minimum": 3}}}
        },
        {
          "if": {"properties": {"evidence_route": {"const": "TWO_ITEMS_PLUS_OWNER_ELICITATION"}}, "required": ["evidence_route"]},
          "then": {
            "properties": {
              "independent_normative_evidence_count": {"minimum": 2},
              "elicitation_confirmed": {"const": true}
            }
          }
        },
        {
          "if": {"properties": {"evidence_route": {"const": "EXPLICIT_OWNER_ASSERTION"}}, "required": ["evidence_route"]},
          "then": {"properties": {"evidence_refs": {"minItems": 1}}}
        }
      ]
    }
  }
}
