{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://efishother.com/schemas/r29b2m_r2_scenario_spec.schema.json",
  "title": "R29B2M-R2 Scenario-Grounded Dialogue Spec",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "scenario_id", "family_id", "capability", "dialogue_act", "messages",
    "world_facts", "user_request", "active_referent", "alternative_referents",
    "active_constraints", "removed_constraints", "correction_before",
    "correction_after", "source_text", "requested_transformation",
    "target_fact_ids", "forbidden_fact_ids", "must_include_values",
    "must_exclude_values", "maximum_answer_characters", "tone_contract",
    "canonical_targets", "prompt_variants", "provenance", "review_status",
    "split_group", "split"
  ],
  "properties": {
    "scenario_id": {"type": "string", "minLength": 1},
    "family_id": {"type": "string", "minLength": 1},
    "family_kind": {"type": "string"},
    "capability": {"type": "string", "minLength": 1},
    "dialogue_act": {"type": "string", "minLength": 1},
    "messages": {"$ref": "#/$defs/messages"},
    "world_facts": {"type": "object", "additionalProperties": {"type": "string"}},
    "user_request": {"type": "string", "minLength": 1},
    "active_referent": {"type": ["string", "null"]},
    "alternative_referents": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "active_constraints": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "removed_constraints": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "correction_before": {"type": ["string", "null"]},
    "correction_after": {"type": ["string", "null"]},
    "source_text": {"type": ["string", "null"]},
    "requested_transformation": {"type": ["string", "null"], "enum": [null, "shorten", "polite", "direct", "casual", "formal", "summary"]},
    "source_fact_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "requested_addition_fact_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "target_fact_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "forbidden_fact_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "must_include_values": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "must_exclude_values": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "maximum_answer_characters": {"type": "integer", "minimum": 1, "maximum": 192},
    "tone_contract": {"type": "string", "minLength": 1},
    "canonical_targets": {"type": "array", "minItems": 3, "maxItems": 5, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "prompt_variants": {"type": "array", "minItems": 3, "maxItems": 6, "items": {"$ref": "#/$defs/promptVariant"}},
    "provenance": {"const": "project_authored_r29b2m_r2"},
    "review_status": {"enum": ["pass", "repaired", "project_authored_reviewed"]},
    "split_group": {"type": "string", "minLength": 1},
    "split": {"enum": ["train", "dev"]},
    "missing_field": {"type": ["string", "null"]}
  },
  "$defs": {
    "message": {
      "type": "object",
      "required": ["role", "content"],
      "additionalProperties": false,
      "properties": {"role": {"enum": ["user", "assistant"]}, "content": {"type": "string", "minLength": 1}}
    },
    "messages": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"$ref": "#/$defs/message"}},
    "promptVariant": {
      "type": "object",
      "required": ["prompt_variant_id", "messages", "operator_ids"],
      "additionalProperties": false,
      "properties": {
        "prompt_variant_id": {"type": "string", "minLength": 1},
        "messages": {"$ref": "#/$defs/messages"},
        "operator_ids": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
