{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://efishother.local/schemas/r30j0_p2_persona_antipattern_map_v1.schema.json",
  "title": "PersonaAntiPatternMapV1",
  "description": "Candidate not-efish behaviours and caricature boundaries, all pending owner review.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "status", "owner_review_completed", "allowed_for_training", "entries"],
  "properties": {
    "version": {"const": "persona-antipattern-map.v1"},
    "status": {"enum": ["EMPTY_TEMPLATE", "HYPOTHESES_OWNER_REVIEW_REQUIRED", "OWNER_REVIEW_IN_PROGRESS"]},
    "owner_review_completed": {"const": false},
    "allowed_for_training": {"const": false},
    "entries": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/antiPattern"}
    }
  },
  "$defs": {
    "safeId": {"type": "string", "pattern": "^(?!wired$)[a-z][a-z0-9._-]{2,127}$"},
    "publicSafeText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "not": {"pattern": "[Ww][Ii][Rr][Ee][Dd]"}
    },
    "register": {
      "enum": [
        "ordinary_chat",
        "casual_banter",
        "weird_question",
        "absurd_meta_ai",
        "practical_advice",
        "technical_explanation",
        "debugging",
        "project_discussion",
        "academic_discussion",
        "philosophy",
        "personal_reflection",
        "light_emotional",
        "formal_message",
        "creative_play",
        "roleplay"
      ]
    },
    "behaviourClass": {
      "enum": [
        "TEXT_SEMANTIC",
        "TEXT_STYLE",
        "PRESENTATION",
        "INTERACTION_POLICY",
        "ROLEPLAY",
        "META_AI",
        "UNKNOWN"
      ]
    },
    "antiPattern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anti_pattern_id",
        "candidate_anti_behaviour",
        "behaviour_class",
        "trigger_contexts",
        "compatible_registers",
        "forbidden_registers",
        "failure_transition",
        "reverse_control_refs",
        "evidence_refs",
        "evidence_count",
        "contradiction_count",
        "confidence",
        "owner_review_status",
        "owner_review_required",
        "allowed_for_training",
        "contains_raw_excerpt"
      ],
      "properties": {
        "anti_pattern_id": {"$ref": "#/$defs/safeId"},
        "candidate_anti_behaviour": {"$ref": "#/$defs/publicSafeText"},
        "behaviour_class": {"$ref": "#/$defs/behaviourClass"},
        "trigger_contexts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/publicSafeText"}
        },
        "compatible_registers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/register"}
        },
        "forbidden_registers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/register"}
        },
        "failure_transition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["useful_behaviour", "becomes_harmful_when", "harmful_result"],
          "properties": {
            "useful_behaviour": {"$ref": "#/$defs/publicSafeText"},
            "becomes_harmful_when": {"$ref": "#/$defs/publicSafeText"},
            "harmful_result": {"$ref": "#/$defs/publicSafeText"}
          }
        },
        "reverse_control_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/safeId"}
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/safeId"}
        },
        "evidence_count": {"type": "integer", "minimum": 0},
        "contradiction_count": {"type": "integer", "minimum": 0},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "owner_review_status": {"enum": ["UNREVIEWED", "ACCEPT", "REJECT", "EDIT", "DEPENDS", "UNSURE"]},
        "owner_review_required": {"const": true},
        "allowed_for_training": {"const": false},
        "contains_raw_excerpt": {"const": false}
      }
    }
  }
}
